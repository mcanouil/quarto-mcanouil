/_site/
/.quarto/
**/*.quarto_ipynb

# Generated by _scripts/pre-render.sh, removed by _scripts/post-render.sh:
# changelog.qmd from CHANGELOG.md, _variables.yml and _atelier-version.yml from
# the extension manifest.
/changelog.qmd
/_variables.yml
/_atelier-version.yml

# The extension this repository publishes, copied from the root by
# _scripts/sync-extension.sh under a `local` owner. Everything else under
# _extensions/ is a committed dependency. See _extensions/README.md.
/_extensions/local/

# The demo project and its output, generated by _scripts/render-demos.sh. The
# extension copy under _demos/ comes from _scripts/sync-extension.sh.
/demos/
/_demos/_extensions/
/_demos/_output/
/_demos/*.typ
/_demos/*_files/

# The sample project and its output, generated by _scripts/render-samples.sh.
# The extension copy under _samples/ comes from _scripts/sync-extension.sh, and
# render-samples.sh downloads the speaker photo.
/samples/
/_samples/_extensions/
/_samples/_output/
/_samples/*.typ
/_samples/*_files/
/_samples/speaker.png
